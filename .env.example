# Server Configuration
SERVER_PORT=9092
TRANSPORT_MODE=stdio

# HTTP transports: comma-separated browser origins allowed to call /mcp.
# Leave empty when only non-browser clients connect.
MCP_ALLOWED_ORIGINS=
# Required when TRANSPORT_MODE=streamable; keep this in a secret manager.
DB_MCP_API_KEY=
# Optional OIDC mode. When issuer is set, OIDC replaces the static pilot key.
DB_MCP_OIDC_ISSUER=
DB_MCP_OIDC_AUDIENCE=
# Scopes granted to the static pilot key. Add db:write only for DML tools.
DB_MCP_API_SCOPES=db:read

# Logging configuration
LOG_LEVEL=info

# Legacy Single Database Configuration (optional)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname

# Multi-Database Configuration
DB_CONFIG_FILE=config.json
QUERY_TIMEOUT_SECONDS=30

# Optional append-only audit file. The server creates it with mode 0600.
# DB_MCP_AUDIT_LOG=./logs/audit.jsonl

# Note: Create a copy of this file as .env and modify it with your own values.
